# ==============================================================================
# NexERP Enterprise Environment Configuration Template
# NOTE: Copy this file to .env and configure your environment specific parameters.
# DO NOT commit real secrets or production .env files to version control.
# ==============================================================================

# System Environment (development | staging | production | testing)
ENVIRONMENT=development
DEBUG=true
APP_NAME=NexERP
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

# Server Bind Settings
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Multi-Tenancy & Default Organization
DEFAULT_TENANT_ID=org_corp_hq_001
DEFAULT_TENANT_NAME="Apex Dynamics Enterprise"
DEFAULT_CURRENCY=USD

# Database Connection (PostgreSQL 16 Async Engine)
# Example: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexerp_db
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/nexerp_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# In-Memory SQLite Fallback for Lightweight Testing / Local Dev
USE_SQLITE_DEV=false
SQLITE_DB_PATH=./nexerp_dev.db

# Redis Cache & Message Broker (Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Cryptographic Security & JWT Tokens
# Generate a secure 256-bit key using: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24

# CORS Allowed Origins (Comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Storage Vault Configuration
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage/vault
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,xlsx,csv,png,jpg,jpeg,zip

# Accounting & Fiscal Rules
STRICT_ACCOUNTING_PERIOD_LOCK=true
ALLOW_UNBALANCED_JOURNAL_DRAFTS=false
DEFAULT_DEPRECIATION_CONVENTION=full_month
TAX_CALCULATION_DECIMALS=4
CURRENCY_PRECISION_DECIMALS=2

# Notification & Email (SMTP) - Optional
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_FROM_EMAIL=notifications@nexerp.local
SMTP_FROM_NAME="NexERP Automated Dispatcher"
